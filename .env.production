# Loaded automatically for Release bundles (Xcode Product → Archive, EAS
# production builds): Expo CLI reads .env.production when NODE_ENV=production,
# and it wins over .env. Dev/Metro (NODE_ENV=development) ignores this file,
# so the LAN URL in .env keeps working for day-to-day dev. No manual switching.
EXPO_PUBLIC_API_BASE_URL=https://vehify.app
