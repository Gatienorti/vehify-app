    "@reduxjs/toolkit": "^2.12.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.4",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.3",
    "expo-build-properties": "~57.0.5",
    "expo-camera": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
