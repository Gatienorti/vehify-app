# Copy to .env and adjust. Only EXPO_PUBLIC_* vars are exposed to the app.

# Base URL of the Laravel backend (../vehify-web). No trailing slash.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Keep true to run every flow against in-app mock data while the backend is
# being built. Set to false once the backend endpoints are live.
EXPO_PUBLIC_USE_MOCKS=true
