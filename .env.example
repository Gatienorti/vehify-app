# Copy to .env and adjust. Only EXPO_PUBLIC_* vars are exposed to the app.

# Base URL of the Laravel backend (../vehify-web). No trailing slash.
# The backend serves mock data via its provider layer until real providers are
# wired — there is no in-app mock mode. Use your Mac's LAN IP (not localhost)
# when testing on a physical phone, with `php artisan serve --host=0.0.0.0`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
